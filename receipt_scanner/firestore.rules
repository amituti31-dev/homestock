rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /households/{householdId} {
      // Any signed-in user can look up a household by its ID (the ID doubles
      // as the invite code) so the join flow can verify it exists.
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.createdBy;

      // Existing members can update household fields (rename, profile sync).
      // Non-members may update only to add themselves to `members` (join flow).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (
          request.auth.uid in request.resource.data.members &&
          !(request.auth.uid in resource.data.members)
        )
      );

      match /items/{itemId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      match /shoppingList/{itemId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
